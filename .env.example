# Discord Bot Configuration
# Get your bot token from Discord Developer Portal: https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# The Discord channel ID where notifications will be sent
DISCORD_CHANNEL_ID=your_channel_id_here

# Admin Discord User IDs (comma-separated)
# These users can approve ZeroTier requests
# Get your user ID: enable Developer Mode in Discord, right-click your name, "Copy User ID"
ADMIN_DISCORD_IDS=123456789012345678,987654321098765432

# Minecraft Server Configuration
# The IP address or hostname of your Minecraft server
MC_SERVER_HOST=your.server.ip.address

# The port of your Minecraft server (default: 25565)
MC_SERVER_PORT=25565

# Server exposure mode: 'public' or 'private'
# - public:  Server accessible from internet (port forwarded, VPS, etc.)
# - private: Server behind NAT/firewall, needs ZeroTier for players
MC_EXPOSURE_MODE=public

# Public hostname/IP that players use to connect
# (Usually same as MC_SERVER_HOST for public servers)
MC_PUBLIC_HOST=your.server.ip.address

# ZeroTier Configuration (only required when MC_EXPOSURE_MODE=private)
# Get API token from: https://my.zerotier.com/account
ZT_ENABLED=false
ZT_API_TOKEN=
# 16-character hex Network ID (find at https://my.zerotier.com/networks)
ZT_NETWORK_ID=

# How often to poll ZeroTier for newly authorized members (ms)
ZT_POLL_INTERVAL_MS=60000

# Web Dashboard Configuration
# Enable web dashboard for setup + monitoring
WEB_ENABLED=true
WEB_HOST=127.0.0.1
WEB_PORT=3000

# Polling Configuration
# How often to check server status (in milliseconds)
# 30000 = 30 seconds, 60000 = 1 minute, 15000 = 15 seconds
POLLING_INTERVAL_MS=30000

# Server check timeout (in milliseconds)
# If server doesn't respond within this time, it's considered offline
POLLING_TIMEOUT_MS=5000
