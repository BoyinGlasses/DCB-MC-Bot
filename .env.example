# Discord Bot Configuration
# Get your bot token from Discord Developer Portal: https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# The Discord channel ID where notifications will be sent
# Right-click on a channel in Discord and select "Copy Channel ID"
# (Developer mode must be enabled in Discord settings)
DISCORD_CHANNEL_ID=your_channel_id_here

# Minecraft Server Configuration
# The IP address or hostname of your Minecraft server
MC_SERVER_HOST=your.server.ip.address

# The port of your Minecraft server (default: 25565)
MC_SERVER_PORT=25565

# Polling Configuration
# How often to check server status (in milliseconds)
# 30000 = 30 seconds, 60000 = 1 minute, 15000 = 15 seconds
POLLING_INTERVAL_MS=30000

# Server check timeout (in milliseconds)
# If server doesn't respond within this time, it's considered offline
POLLING_TIMEOUT_MS=5000
